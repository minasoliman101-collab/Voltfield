# Netlify _headers — Netlify does NOT read staticwebapp.config.json (that's Azure-only),
# so caching rules need to live here instead. Same intent as that file: long cache for
# large/rarely-changing data files, short cache for HTML, no-cache for the service worker.

/sw.js
  Cache-Control: no-cache

/.netlify/identity/*
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: public, max-age=86400


# The shared stylesheets get a SHORT max-age, unlike the data files below.
# They were on 24 hours, which was reasonable when they held only tokens and
# header chrome. They now carry the whole visual system, so they change on
# every design deploy -- and because the HTML is network-first while these were
# a day stale, a returning visitor could get new markup painted with the old
# stylesheet. That is not a stale page, it is a broken one. Ten minutes, with
# background revalidation, keeps them cheap without that failure mode.
/voltfield-core.css
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/voltfield-dark-mode.css
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/voltfield-site-config.js
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

# Self-hosted three.js. The version is pinned in the path (vendor/three/ is a
# copy of three@0.160.0), so these bytes can never change for a given URL --
# upgrading means writing a new directory. That makes immutable correct here,
# unlike everything else on this site, and it means the 1.2 MB core is fetched
# once per visitor rather than on every 3D page.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=2592000

/images/*
  Cache-Control: public, max-age=2592000, immutable

# Social/OG cards. Long cache but NOT immutable -- if a card is regenerated,
# the filename stays the same and scrapers need to be able to pick up the
# new version on their next fetch.
/social/*
  Cache-Control: public, max-age=604800

/voltfield-catalog-data.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/voltfield-bom-engine.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/voltfield-eol-data.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# /voltfield-oem-data.js had a rule here for a file that was deleted from the
# repo, and /voltfield-site-config.js had a second rule that shadowed the
# ten-minute one set for it above. Both removed: one rule per file, and no
# rules for files that do not exist.

/*.html
  Cache-Control: public, max-age=600, stale-while-revalidate=3600

/lead-time-index.json
  Cache-Control: public, max-age=1800, stale-while-revalidate=3600
  Access-Control-Allow-Origin: *

/embed/lead-time-widget.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/ads.txt
  Cache-Control: public, max-age=86400

# Shared front-end modules. These originally had no rule and fell through to
# Netlify's default (max-age=0, must-revalidate), which revalidated them on
# every page load; they were then put on 24 hours to stop that.
#
# Ten minutes, not a day. These are CODE, and code here changes on every
# deploy: a 24-hour cache meant a returning visitor ran the previous build's
# JavaScript against the current build's HTML for up to a day. That is the same
# failure the stylesheets were moved off 86400 for, and it bit again -- an
# antialiasing fix shipped to voltfield-3d.js was invisible on the live site
# because the browser still held yesterday's copy. stale-while-revalidate keeps
# the request cheap; max-age just stops it going stale for a day.
#
# voltfield-dark-mode.css also had a duplicate entry down here that silently
# overrode the short cache set for it next to core.css. One rule per file now.
/voltfield-3d.js
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/voltfield-component-viz.js
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/voltfield-component-viz.css
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/voltfield-progress.js
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Clickjacking: nothing here is meant to be framed by another site. The
  # lead-time widget is served as a script for embedding, not as an iframe,
  # so denying frames costs nothing.
  X-Frame-Options: DENY
  # Turn off device APIs the site never uses, so a future injected script
  # cannot quietly reach for them.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=()

# 3D-rendered tool thumbnails. Content-addressed by name only, so long cache
# but not immutable -- regenerating one reuses its filename.
/images/tools/*
  Cache-Control: public, max-age=604800
